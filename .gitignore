# Virtual environments, if you make your own next to the code
venv/
.venv/
env/

# SLURM job output. The sbatch scripts write to logs/, and --output is resolved
# at submit time, so each tier's README tells you to `mkdir -p logs` in setup.
logs/

# Python
__pycache__/
*.py[cod]
*.egg-info/

# Tier 4 uploads and job results
04-web-gui/inputs/*
!04-web-gui/inputs/README.md
04-web-gui/results/

# Slide build intermediates (slides-src/)
slides-src/template.pptx
slides-src/unpacked/
slides-src/*.pdf
slides-src/slide-*.jpg
slides-src/*thumbs*.jpg

# Model caches, if anyone points HF_HOME here by accident
hf_cache/

# macOS
.DS_Store

# Local agent/editor state
.claude/
.claude.json
